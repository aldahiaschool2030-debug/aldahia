{
  "version": 2,
  "builds": [
    {
      "src": "artifacts/api-server/src/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "artifacts/aldahia-admin/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "artifacts/api-server/src/index.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "artifacts/aldahia-admin/dist/public/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "artifacts/aldahia-admin/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "status": 200,
      "dest": "artifacts/aldahia-admin/index.html"
    }
  ]
}
